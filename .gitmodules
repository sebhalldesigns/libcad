[submodule "extern/SDL"]
	path = extern/SDL
	url = https://github.com/libsdl-org/SDL.git
[submodule "extern/cimgui"]
	path = extern/cimgui
	url = https://github.com/cimgui/cimgui.git
[submodule "extern/skia"]
	path = extern/skia
	url = https://github.com/google/skia
[submodule "extern/ninja"]
	path = extern/ninja
	url = https://github.com/ninja-build/ninja
[submodule "extern/cglm"]
	path = extern/cglm
	url = https://github.com/recp/cglm
[submodule "extern/dawn"]
	path = extern/dawn
	url = https://github.com/google/dawn
	ignore = all